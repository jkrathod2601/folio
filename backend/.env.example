NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Where the Vite dev server lives. Google sign-in bounces back here.
FRONTEND_URL=http://localhost:5173

# Extra origins allowed to make credentialed requests, comma separated. Only
# needed for additional deployments (a Vercel preview, say); the main frontend
# is already allowed via FRONTEND_URL. In dev this can stay empty.
CORS_ALLOWED_ORIGINS=

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/folio
DB_NAME=folio
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT_MS=5000

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both must be >= 32 chars. Rotating ACCESS invalidates nothing on disk;
# rotating REFRESH logs everybody out.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=folio-backend
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000

# Cookies. The refresh cookie is httpOnly and lives on THIS origin, so in the
# split production deployment (SPA on Vercel, API on Render) it is cross-site
# and MUST be SameSite=None; Secure — browsers drop a None cookie without
# Secure, and the symptom is a user silently signed out on every reload.
# Locally the two are same-origin through the Vite proxy, so Lax still works
# over plain http and is what you want in dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Accounts promoted to `admin` on their next Google sign-in. Comma separated.
# This is how the first admin is created — it is the only path to an admin that
# does not already require an existing admin. Leave empty once you have one and
# prefer `npm run set-role -- you@example.com admin` for changes after that.
ADMIN_EMAILS=

# Google OAuth — the only sign-in provider. Create a Web application client at
# https://console.cloud.google.com/apis/credentials and add
# GOOGLE_REDIRECT_URI as an authorised redirect URI. Blank in dev is allowed,
# but the server refuses to boot without it in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
